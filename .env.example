# EXPO_PUBLIC_*-prefixed vars are bundled into the client automatically by
# Expo — no extra config needed to read this via process.env.
EXPO_PUBLIC_TIMEZONE=Asia/Kolkata

# LAN IP of the machine running the backend, in dev only. Android
# emulators/devices can't resolve "localhost" back to the host machine the
# way iOS simulators can, so the Android dev build needs an explicit IP.
# Set this to your own machine's LAN IP.
EXPO_PUBLIC_DEV_ANDROID_HOST=192.168.0.110

# Backend to talk to. LEAVE UNSET for normal work — config/env.ts then picks
# the right default on its own: localhost / EXPO_PUBLIC_DEV_ANDROID_HOST in a
# dev build, and the deployed staging backend in a release build.
#
# Set it only to override that, e.g. to point a DEV build at staging so you can
# reproduce something against real data:
#   EXPO_PUBLIC_API_BASE_URL=https://staging.suntechinfra.com:8443/api
#
# Inlined at BUILD time, so a change needs a bundler restart, not just an app
# reload.
# EXPO_PUBLIC_API_BASE_URL=
