# EXPO_PUBLIC_*-prefixed vars are bundled into the client automatically by
# Expo — no extra config needed to read this via process.env.
EXPO_PUBLIC_TIMEZONE=Asia/Kolkata

# LAN IP of the machine running the backend, in dev only. Android
# emulators/devices can't resolve "localhost" back to the host machine the
# way iOS simulators can, so the Android dev build needs an explicit IP.
# Set this to your own machine's LAN IP.
EXPO_PUBLIC_DEV_ANDROID_HOST=192.168.0.110
